	<body data-sveltekit-preload-data="hover" data-analytics-section="body">
		<div style="display: contents"><!--[--><!--[--><!----><!--[--><!----><!----><!----> <!----> <!--[--><!----><script type="text/javascript">

			let insertScriptsCache = [];
			let insertHtmlCache = [];
			let timerCounter = 0;
			let isEdit = false;
			let oneTrustInited = false;
			let utagInited = false;

			window.logitech = window.logitech || {};

			/**
			 * OneTrust cookie category mappings
			 */
			window.logitech.COOKIES_STRICTLY_NECESSARY = 'C0001';
			window.logitech.COOKIES_ANALYTICS = 'C0002';
			window.logitech.COOKIES_FUNCTIONAL = 'C0003';
			window.logitech.COOKIES_MARKETING = 'C0004';
			window.logitech.COOKIES_SOCIAL_MEDIA = 'C0005';

			/**
			 * Returns true or false depending on whether or not user has consented to a certain cookies group
			 * @param cookieGroupId String : should pass one of the window.logitech.COOKIES_<XXX> constants
			 */
			window.logitech.doesUserAllowCookiesFor = function( cookieGroupId ) {
				if(typeof cookieGroupId !== 'string') {
					return false;
				}

				cookieGroupId = cookieGroupId.toUpperCase();

				for(let i=0, t = window.logitech.acceptedCookieGroups?.length; i < t; i++) {
					if(cookieGroupId === window.logitech.acceptedCookieGroups[i]) {
						return true;
					}
				}

				return false;
			};

			// acceptedCookieGroups must be defined
			function parseCookieGroups() {
				let acceptedGroups = [];

				if (typeof OnetrustActiveGroups !== 'undefined') {
					acceptedGroups = OnetrustActiveGroups.split(',');
					acceptedGroups = acceptedGroups.filter((group) => {
						return group !== '' && group !== undefined && group !== null;
					});
				} else {
					acceptedGroups = acceptedCookieGroups();
				}

				return acceptedGroups;
			}

			const initUtag = () => {
				window.logitech.acceptedCookieGroups = parseCookieGroups();

				if (
					typeof utag_data === 'undefined' ||
					typeof window.logitech.initUtagSync === 'undefined' ||
					typeof window.logitech.initUtagAsync === 'undefined'
				) {
					if (timerCounter < 500) {
						window.requestAnimationFrame(initUtag);
					}
					timerCounter++;
					return;
				}

				if (utagInited === true) {
					return;
				}

				utagInited = true;

				// tell utag.sync.js to init
				try {
					window.logitech.initUtagSync();
				} catch (err) {
					console.error('Tealium utag.sync failed to initialize');
					console.error(err);
				}

				// tell utag.js to load
				try {
					window.logitech.initUtagAsync();
				} catch (err) {
					console.error('Tealium utag.js failed to initialize');
					console.error(err);
				}
			};
			const insertScriptsAndHtml = () => {
				insertScriptsCache.forEach((obj) => {
					insertScript(obj.url, obj.selector, obj.callback, obj.groupId);
				});

				insertHtmlCache.forEach((obj) => {
					insertHtml(obj.html, obj.selector, obj.callback, obj.groupId);
				});
			};

			/**
			 * adapter for OneTrust.InsertScript method
			 * https://my.onetrust.com/s/article/UUID-730ad441-6c4d-7877-7f85-36f1e801e8ca
			 * @param url String : JS src/href
			 * @param selector String : where to embed the script. Valid values are 'head', or ID (without the hash)
			 * @param callback Function|null : function to call when script is loaded
			 * @param groupID String|Array : cookie categorization group (C0001, C0002, etc...)
			 */
			const insertScript = (url, selector, callback, groupId) => {
				selector = selector || 'head';

				if (Array.isArray(groupId)) {
					groupId = groupId.join('-');
				}

				const alreadyCached = insertScriptsCache.some(
					(obj) => obj.url === url && obj.selector === selector,
				);

				if (alreadyCached !== true) {
					insertScriptsCache.push({ url, selector, callback, groupId });
				}

				if (isEdit) {
					let script = document.createElement('script');
					script.src = url;
					script.type = 'text/javascript';
					if (typeof callback === 'function') {
						script.addEventListener('load', callback);
					}
					if (selector !== 'head') {
						selector = '#' + selector;
					}
					document.querySelector(selector).appendChild(script);
				} else if (oneTrustInited) {
					//console.log('OneTrust.InsertScript exists. Letting OneTrust manage', url);
					OneTrust.InsertScript(url, selector, callback, null, groupId);
				} else if (alreadyCached !== true) {
					//console.log('OneTrust.InsertScript does not exist. Cache it and wait', url);
				}
			};

			/**
			 * adapter for OneTrust.InsertHtml method
			 * https://my.onetrust.com/s/article/UUID-730ad441-6c4d-7877-7f85-36f1e801e8ca
			 * @param html String : HTML to embed (as a String)
			 * @param selector String : parent ID of where to embed the html (without the hash)
			 * @param callback Function|null : function to call when script is loaded
			 * @param groupID String|Array : cookie categorization group (C0001, C0002, etc...)
			 */
			const insertHtml = (html, selector, callback, groupId) => {
				if (Array.isArray(groupId)) {
					groupId = groupId.join('-');
				}

				const alreadyCached = insertHtmlCache.some(
					(obj) => obj.html === html && obj.selector === selector,
				);

				if (alreadyCached !== true) {
					insertHtmlCache.push({ html, selector, callback, groupId });
				}

				if (isEdit) {
					//console.log("We're in author mode. Allow html to be added.", html);
					let div = document.createElement('div');
					div.innerHTML = html;
					document.querySelector('#' + selector).appendChild(div);
					if (typeof callback === 'function') {
						callback.call(this);
					}
				} else if (oneTrustInited) {
					//console.log('OneTrust.InsertHtml exists. Letting OneTrust manage', html);
					OneTrust.InsertHtml(html, selector, callback, null, groupId);
				} else if (alreadyCached !== true) {
					//console.log('OneTrust.InsertHtml does not exist. Cache it and wait', html);
				}
			};

			window.OptanonWrapper = function () {
				//console.log('OneTrust initialized', OnetrustActiveGroups);
				oneTrustInited = true;
				initUtag();

				// this method is called anytime cookie consent is changed
				OneTrust.OnConsentChanged((e) => {

					console.log(
						'OneTrust.OnConsentChanged, old, new:',
						window.logitech.acceptedCookieGroups,
						parseCookieGroups(),
					);

					window.logitech.acceptedCookieGroups = parseCookieGroups();
					console.log('Consent changed', window.logitech.acceptedCookieGroups);

					//window.location.reload();

					// // tell ue.sync.js to reinit
					// try {
					// 	window.logitech.reinitUtagSync();
					// } catch (err) {
					// 	console.error('Tealium utag.sync failed to re-initialize');
					// 	console.error(err);
					// }

					// // trigger utag.async.js to re-run its load rules and init any tags the user has opted into
					// try {
					// 	utag.view(utag_data);
					// } catch (err) {
					// 	console.error('utag.view(utag_data) failed');
					// 	console.error(err);
					// }

					// // re-call all calls to insertScript and insertHtml
					// insertScriptsAndHtml();
				});

				// add accessibility region
				let otConsentWrapper = document.getElementById('onetrust-consent-sdk');
				if (otConsentWrapper) {
					otConsentWrapper.setAttribute('role', 'region');
					otConsentWrapper.setAttribute('aria-label', 'Cookies Consent');
				}
				document.getElementById('onetrust-pc-sdk').setAttribute('style', 'display:none');
